{
  "manifest_version": 3,
  "name": "StackPicker",
  "version": "1.0.0",
  "description": "Detect the tech stack of any website",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "host_permissions": ["<all_urls>"],
  "permissions": ["storage", "tabs", "scripting", "webRequest"]
}
