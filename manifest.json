{
  "manifest_version": 3,
  "name": "StackPicker",
  "version": "1.0.0",
  "description": "See the tech stack behind any website — frameworks, CMS, servers, CDNs — in one click.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Show this site's tech stack",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "minimum_chrome_version": "102"
}
