{
  "manifest_version": 3,
  "name": "StackPicker - Website Technology & Tech Stack Detector",
  "short_name": "StackPicker",
  "version": "1.1.1",
  "description": "Detect the tech stack of any website in one click: framework, CMS, analytics, web server, CDN and 3,500+ more web technologies.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Show this site's tech stack",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "minimum_chrome_version": "102"
}